rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // User ID -> email lookup, so people can log in with a User ID.
    // `get` is public (needed before login); listing is not allowed.
    match /userIds/{id} {
      allow get: if true;
      allow create: if signedIn()
                    && id.matches('^[a-z0-9_.-]{3,20}$')
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Each person's own profile (User ID, email, which house they're in).
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /houses/{houseId} {
      // The 10-character invite code IS the house id, so it can be fetched (not listed) by any signed-in user to join.
      allow get: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUids;
      allow update: if signedIn() && (
                      request.auth.uid in resource.data.memberUids
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
                          && request.auth.uid in request.resource.data.memberUids)
                    );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // bills, market, periods
      match /{collection}/{docId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.memberUids;
      }
    }
  }
}
